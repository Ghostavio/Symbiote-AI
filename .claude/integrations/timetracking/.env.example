# Modelo do .env desta pasta. Copie para .env e preencha com as suas credenciais.
# Nunca versione o .env.

# Clockify: https://app.clockify.me/user/preferences, aba API, Generate
CLOCKIFY_API_TOKEN=
# Ids do Clockify (como obter: ver a seção 2 do README.md desta pasta)
CLOCKIFY_WORKSPACE_ID=
CLOCKIFY_PROJECT_ID=
# Opcional: só para listar entradas (o sync-clockify.sh não usa)
CLOCKIFY_USER_ID=

# 7pace (fallback legado do scripts/sync-7pace.sh; o recomendado é exportar
# no shell com a skill /setup-7pace). Troque <SEVENPACE_ORG> pelo valor real.
SEVENPACE_API_TOKEN=
SEVENPACE_BASE_URL='https://<SEVENPACE_ORG>.timehub.7pace.com'
