{
  "id": "angular",
  "name": "Angular",
  "category": "stack",
  "version": "1.0.0",
  "description": "Convenções, checks de revisão e preferências de editor para aplicações Angular modernas (standalone components, Signals, OnPush, Clean Architecture, Vitest e Playwright).",
  "detect": {
    "files": [
      "angular.json"
    ],
    "packages": [
      "@angular/core",
      "@angular/cli"
    ]
  },
  "commands": {
    "lint": "yarn lint",
    "typecheck": "npx tsc --noEmit",
    "test": "yarn ng test --watch=false",
    "e2e": "npx playwright test --reporter=list",
    "build": "yarn build",
    "dev": "yarn start"
  },
  "files": {
    "conventions": "conventions.md",
    "review_checks": "review-checks.md",
    "editor_settings": "editor-settings.json"
  }
}
